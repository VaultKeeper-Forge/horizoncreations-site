# Shopify backend scaffold
# Copy this file to `.env.local` for local-only secrets, or set the vars directly in your shell / CI.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=replace-me
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-me
SHOPIFY_API_VERSION=2026-04

# Meta / Facebook / Instagram import scaffold
# Use a long-lived Meta access token with the right scopes for your Page and linked Instagram business account.
META_ACCESS_TOKEN=replace-me
META_GRAPH_API_VERSION=v24.0
META_FACEBOOK_PAGE_ID=replace-me
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=replace-me
META_IMPORT_LIMIT=12

# Discord bot for Rivet / The Shop
DISCORD_BOT_TOKEN=replace-me
DISCORD_CLIENT_ID=replace-me
# Set this while developing so slash command changes appear immediately.
DISCORD_GUILD_ID=replace-me
DISCORD_OWNER_USER_ID=replace-me
DISCORD_ANNOUNCEMENT_CHANNEL_ID=replace-me
DISCORD_SUPPORT_ROLE_NAME=Shop Crew
DISCORD_ENABLE_MESSAGE_CONTENT=false
SHOP_MACHINE_CAMERA_NAME=Logi C615 HD WebCam
SHOP_MACHINE_CAMERA_SIZE=1280x720
FFMPEG_PATH=ffmpeg

# Public links used by the Discord bot.
SHOP_WEBSITE_URL=https://horizoncreations.art
SHOP_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61574262374190
SHOP_INSTAGRAM_URL=https://instagram.com/horizoncreations.art/
SHOP_DISCORD_INVITE_URL=https://discord.gg/replace-me

# Optional website build-time Discord link.
SITE_DISCORD_URL=https://discord.gg/replace-me
